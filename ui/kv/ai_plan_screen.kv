<AIPlanScreen>:
    name: "ai_plan"

    canvas.before:
        Color:
            rgba: 0.97, 0.98, 0.99, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: [dp(24), dp(24)]
        spacing: dp(20)

        # Верхняя панель
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            spacing: dp(12)

            Button:
                text: "‹ Назад"
                font_size: "16sp"
                size_hint_x: 0.25
                background_color: 0, 0, 0, 0
                background_normal: ""
                color: 0.25, 0.65, 0.95, 1
                bold: True
                on_press: root.go_back()
                canvas.before:
                    Color:
                        rgba: 0.92, 0.96, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12)]

            Label:
                text: "AI План"
                font_size: "22sp"
                bold: True
                color: 0.12, 0.18, 0.3, 1
                text_size: self.size
                halign: "center"
                valign: "middle"

            Widget:
                size_hint_x: 0.25

        ScrollView:
            do_scroll_x: False
            bar_color: 0.25, 0.65, 0.95, 0.7
            bar_width: dp(5)

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(20)
                padding: [dp(10), dp(10)]

                # Поле цели
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(85)
                    spacing: dp(8)

                    Label:
                        text: "ЦЕЛЬ"
                        font_size: "11sp"
                        color: 0.45, 0.45, 0.55, 1
                        size_hint_y: 0.3
                        text_size: self.size
                        halign: "left"
                        valign: "bottom"
                        bold: True

                    TextInput:
                        text: root.goal
                        on_text: root.goal = self.text
                        hint_text: "Что хотите достичь? (обязательно)"
                        multiline: False
                        background_color: 1, 1, 1, 1
                        foreground_color: 0.12, 0.18, 0.3, 1
                        padding: [dp(18), dp(14)]
                        font_size: '16sp'
                        cursor_color: 0.25, 0.65, 0.95, 1
                        hint_text_color: 0.7, 0.7, 0.8, 1
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                            Color:
                                rgba: 0.88, 0.92, 0.96, 1
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
                                width: 1.8

                # Текущий уровень
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(75)
                    spacing: dp(8)

                    Label:
                        text: "ТЕКУЩИЙ УРОВЕНЬ (необязательно)"
                        font_size: "11sp"
                        color: 0.45, 0.45, 0.55, 1
                        size_hint_y: 0.3
                        text_size: self.size
                        halign: "left"
                        valign: "bottom"
                        bold: True

                    TextInput:
                        text: root.current_level
                        on_text: root.current_level = self.text
                        hint_text: "Например: подтягиваюсь 5 раз"
                        multiline: False
                        background_color: 1, 1, 1, 1
                        foreground_color: 0.12, 0.18, 0.3, 1
                        padding: [dp(18), dp(14)]
                        font_size: '16sp'
                        cursor_color: 0.25, 0.65, 0.95, 1
                        hint_text_color: 0.7, 0.7, 0.8, 1
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                            Color:
                                rgba: 0.88, 0.92, 0.96, 1
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
                                width: 1.8

                # Желаемый уровень
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(75)
                    spacing: dp(8)

                    Label:
                        text: "ЖЕЛАЕМЫЙ УРОВЕНЬ (необязательно)"
                        font_size: "11sp"
                        color: 0.45, 0.45, 0.55, 1
                        size_hint_y: 0.3
                        text_size: self.size
                        halign: "left"
                        valign: "bottom"
                        bold: True

                    TextInput:
                        text: root.target_level
                        on_text: root.target_level = self.text
                        hint_text: "Например: хочу 30 раз"
                        multiline: False
                        background_color: 1, 1, 1, 1
                        foreground_color: 0.12, 0.18, 0.3, 1
                        padding: [dp(18), dp(14)]
                        font_size: '16sp'
                        cursor_color: 0.25, 0.65, 0.95, 1
                        hint_text_color: 0.7, 0.7, 0.8, 1
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                            Color:
                                rgba: 0.88, 0.92, 0.96, 1
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
                                width: 1.8

                # Время в день
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(85)
                    spacing: dp(8)

                    Label:
                        text: "МИНУТ В ДЕНЬ"
                        font_size: "11sp"
                        color: 0.45, 0.45, 0.55, 1
                        size_hint_y: 0.3
                        text_size: self.size
                        halign: "left"
                        valign: "bottom"
                        bold: True

                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: 0.7
                        spacing: dp(10)

                        TextInput:
                            text: str(int(root.minutes_per_day))
                            on_text: root.minutes_per_day = int(self.text) if self.text.isdigit() else 30
                            hint_text: "30"
                            multiline: False
                            input_filter: "int"
                            background_color: 1, 1, 1, 1
                            foreground_color: 0.12, 0.18, 0.3, 1
                            padding: [dp(18), dp(14)]
                            font_size: '16sp'
                            cursor_color: 0.25, 0.65, 0.95, 1
                            hint_text_color: 0.7, 0.7, 0.8, 1
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(14)]
                                Color:
                                    rgba: 0.88, 0.92, 0.96, 1
                                Line:
                                    rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
                                    width: 1.8

                        Label:
                            text: "мин"
                            size_hint_x: 0.3
                            color: 0.25, 0.65, 0.95, 1
                            font_size: '16sp'
                            bold: True

                # Желаемый срок (дней)
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(75)
                    spacing: dp(8)

                    Label:
                        text: "ЖЕЛАЕМЫЙ СРОК (дней, необязательно)"
                        font_size: "11sp"
                        color: 0.45, 0.45, 0.55, 1
                        size_hint_y: 0.3
                        text_size: self.size
                        halign: "left"
                        valign: "bottom"
                        bold: True

                    TextInput:
                        text: root.desired_days
                        on_text: root.desired_days = self.text
                        hint_text: "60"
                        multiline: False
                        input_filter: "int"
                        background_color: 1, 1, 1, 1
                        foreground_color: 0.12, 0.18, 0.3, 1
                        padding: [dp(18), dp(14)]
                        font_size: '16sp'
                        cursor_color: 0.25, 0.65, 0.95, 1
                        hint_text_color: 0.7, 0.7, 0.8, 1
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                            Color:
                                rgba: 0.88, 0.92, 0.96, 1
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
                                width: 1.8

                # Кнопка выбора даты начала
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(75)
                    spacing: dp(8)

                    Label:
                        text: "ДАТА НАЧАЛА"
                        font_size: "11sp"
                        color: 0.45, 0.45, 0.55, 1
                        size_hint_y: 0.3
                        text_size: self.size
                        halign: "left"
                        valign: "bottom"
                        bold: True

                    Button:
                        text: root.start_date_text
                        font_size: "14sp"
                        background_color: 0, 0, 0, 0
                        background_normal: ""
                        color: 0.25, 0.65, 0.95, 1
                        bold: True
                        on_press: root.select_start_date()
                        size_hint_y: 0.7
                        canvas.before:
                            Color:
                                rgba: 0.92, 0.96, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                            Color:
                                rgba: 0.25, 0.65, 0.95, 0.6
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
                                width: 1.8
                        canvas.after:
                            Color:
                                rgba: 0.25, 0.65, 0.95, 1
                            Triangle:
                                points: [self.right - dp(40), self.center_y - dp(4), self.right - dp(22), self.center_y - dp(4), self.right - dp(31), self.center_y + dp(6)]

                # Кнопка генерации
                Button:
                    text: "СГЕНЕРИРОВАТЬ ПЛАН"
                    size_hint_y: None
                    height: dp(50)
                    background_color: 0, 0, 0, 0
                    background_normal: ""
                    color: 1, 1, 1, 1
                    on_press: root.generate_plan()
                    canvas.before:
                        Color:
                            rgba: 0.25, 0.65, 0.95, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]
                        Color:
                            rgba: 0.18, 0.55, 0.85, 1
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, dp(16)]
                            width: 2

                # Область результата
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(10)

                    Label:
                        text: "РЕЗУЛЬТАТ"
                        font_size: "11sp"
                        color: 0.45, 0.45, 0.55, 1
                        size_hint_y: None
                        height: dp(20)
                        halign: "left"
                        valign: "bottom"
                        bold: True

                    ScrollView:
                        size_hint_y: None
                        height: dp(200)
                        do_scroll_x: False
                        bar_color: 0.25, 0.65, 0.95, 0.7
                        bar_width: dp(4)

                        Label:
                            text: root.result_text
                            font_size: '14sp'
                            color: 0.12, 0.18, 0.3, 1
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"
                            markup: True
                            padding: [dp(10), dp(10)]

                # Кнопка создания задач
                Button:
                    text: "СОЗДАТЬ ЗАДАЧИ В КАЛЕНДАРЕ"
                    size_hint_y: None
                    height: dp(50)
                    background_color: 0, 0, 0, 0
                    background_normal: ""
                    color: 1, 1, 1, 1
                    disabled: not root.can_create
                    opacity: 1 if root.can_create else 0.3
                    on_press: root.create_tasks()
                    canvas.before:
                        Color:
                            rgba: 0.16, 0.63, 0.33, 1 if root.can_create else 0.5
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]
                        Color:
                            rgba: 0.1, 0.5, 0.2, 1 if root.can_create else 0.5
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, dp(16)]
                            width: 2